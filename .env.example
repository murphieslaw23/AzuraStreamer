# Copy to .env on the IONOS VPS, beside compose.prod.yml. Never commit the real file.

# Rewritten on every rollout by deploy/ionos/deploy.sh — no need to set it by hand.
AZURA_IMAGE=ghcr.io/owner/repo@sha256:...

# Loopback port the host TLS reverse proxy forwards to.
AZURA_BIND_PORT=3000

# Required in production; the process refuses to start without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated origins of the Vercel-hosted UI, e.g. https://azurastreamer.vercel.app
# Setting this switches the session cookie to SameSite=None; Secure and enables
# Socket.io CORS for exactly these origins. Leave empty for an all-in-one
# deployment where this process also serves the UI.
PUBLIC_APP_ORIGINS=

# AzuraCast connection details are stored in the application database via the
# settings UI rather than in the environment.
